# Dami server-side configuration
# Copy this file to .env locally and replace placeholders with your own keys.
# Never commit a populated .env file.

INTRON_API_KEY=
GROQ_API_KEY=
EXA_API_KEY=
DAMI_LIVE_WEB=true
DAMI_GROQ_MODEL=openai/gpt-oss-120b

# Optional endpoint overrides
SAHARA_STT_SYNC_URL=https://infer.voice.intron.io/file/v1/upload/sync
SAHARA_TTS_GENERATE_URL=https://infer.voice.intron.io/tts/v1/generate

# Optional desktop host
DAMI_DESKTOP_URL=
