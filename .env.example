# Dami server-side configuration
# Copy this file to .env locally and replace placeholders with your own keys.
# Never commit a populated .env file.

INTRON_API_KEY=
GROQ_API_KEY=
EXA_API_KEY=
DAMI_LIVE_WEB=true
DAMI_GROQ_MODEL=openai/gpt-oss-120b

# Protected development/admin benchmark. Keep the token server-side and share
# it only with authorized judges/testers. Benchmark mode is off in production
# unless explicitly enabled.
DAMI_BENCHMARK_ENABLED=false
DAMI_BENCHMARK_ACCESS_TOKEN=
OPENAI_API_KEY=
DAMI_BENCHMARK_WHISPER_MODEL=whisper-1
DAMI_BENCHMARK_MODEL3_NAME=Meta MMS 1B All
DAMI_BENCHMARK_MODEL3_URL=
HF_TOKEN=

# Optional endpoint overrides
SAHARA_STT_SYNC_URL=https://infer.voice.intron.io/file/v1/upload/sync
SAHARA_TTS_GENERATE_URL=https://infer.voice.intron.io/tts/v1/generate

# Optional desktop host
DAMI_DESKTOP_URL=
