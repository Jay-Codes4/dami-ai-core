# Optional Sahara endpoint overrides.
SAHARA_STT_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_TTS_URL=wss://infer.voice.intron.io/tts/v1/stream

# Electron development/production URLs.
DAMI_DESKTOP_DEV_URL=http://localhost:3000
DAMI_WEB_URL=
